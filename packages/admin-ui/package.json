{
  "name": "@tgp/admin-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./inputs/hierarchy-picker": "./src/inputs/hierarchy-picker/index.ts",
    "./theme": "./src/theme/index.ts",
    "./theme/admin-semantic-tokens.css": "./src/theme/admin-semantic-tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly",
    "lint": "eslint . --max-warnings 0",
    "storybook:coverage": "node ../../tooling/check-storybook-coverage.mjs packages/admin-ui",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check-types": "pnpm typecheck",
    "storybook": "storybook dev --port 6007",
    "storybook:build": "storybook build"
  },
  "devDependencies": {
    "@mantine/hooks": "^9.2.1",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tgp/eslint-config": "workspace:*",
    "@tgp/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.1",
    "jsdom": "^29.1.1",
    "storybook": "^10.4.1",
    "typescript": "5.9.2",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@mantine/core": "^9.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
