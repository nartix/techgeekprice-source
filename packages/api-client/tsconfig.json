{
  "extends": "@tgp/typescript-config/base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "strictNullChecks": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
